rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasOnly(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function hasAll(data, fields) {
      return data.keys().hasAll(fields);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOptionalString(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    function validRoomCode(code) {
      return code is string && code.matches('^[A-HJ-NP-Z2-9]{6}$');
    }

    function validRoomState(state) {
      return state in ['esperando', 'en_juego', 'abandonada', 'finalizada'];
    }

    function validPlayerState(state) {
      return state in ['conectado', 'desconectado', 'listo'];
    }

    function validPublicId(publicId) {
      return publicId is string && publicId.matches('^[0-9]{1,12}$');
    }

    function validMapKey(mapKey) {
      return mapKey in ['pampa', 'grecia', 'medieval'];
    }

    function validLobbyConfig(config) {
      return config is map
        && hasOnly(config, [
          'transicionSeg',
          'nocheSeg',
          'discusionSeg',
          'votacionSeg',
          'revelarRolesAlMorir',
          'votosIndividuales',
          'presetRoles',
          'roles'
        ])
        && config.transicionSeg is int
        && config.transicionSeg >= 1
        && config.transicionSeg <= 10
        && config.nocheSeg is int
        && config.nocheSeg >= 10
        && config.nocheSeg <= 90
        && config.discusionSeg is int
        && config.discusionSeg >= 30
        && config.discusionSeg <= 180
        && config.votacionSeg is int
        && config.votacionSeg >= 10
        && config.votacionSeg <= 60
        && config.revelarRolesAlMorir is bool
        && config.votosIndividuales is bool
        && (
          (!('presetRoles' in config) && !('roles' in config))
          || (
            config.presetRoles in ['RECOMMENDED', 'CLASSIC', 'CHAOTIC', 'PERSONALIZADO']
            && config.roles is string
            && config.roles.matches('^[0-9]{1,2},[0-9]{1,2},[0-9]{1,2},[1-3],[0-9]{1,2},[0-9]{1,2},[0-9]{1,2},[0-9]{1,2},[0-9]{1,2},[0-9]{1,2},[0-9]{1,2}$')
          )
        );
    }

    function validLastResult(data) {
      return !('ultimoResultado' in data)
        || (
          data.ultimoResultado is map
          && hasOnly(data.ultimoResultado, [
            'ganador', 'ronda', 'mapa', 'matchId', 'finalizadaEnLocal'
          ])
          && isString(data.ultimoResultado.ganador, 1, 40)
          && data.ultimoResultado.ronda is int
          && data.ultimoResultado.ronda >= 0
          && data.ultimoResultado.ronda <= 30
          && validMapKey(data.ultimoResultado.mapa)
          && isString(data.ultimoResultado.matchId, 8, 80)
          && data.ultimoResultado.finalizadaEnLocal is int
        );
    }

    function validRoomBase(data) {
      return isString(data.nombre, 1, 60)
        && validRoomCode(data.codigoSala)
        && validRoomState(data.estado)
        && validMapKey(data.mapa)
        && isString(data.mapaNombre, 1, 40)
        && isString(data.hostId, 1, 80)
        && isString(data.hostNombre, 1, 18)
        && isString(data.hostActivoId, 1, 80)
        && data.hostVersion is int
        && data.hostVersion >= 0
        && data.partidaInicialCreada is bool
        && (!('limpiezaPendiente' in data) || data.limpiezaPendiente is bool)
        // Opcional: las salas creadas antes de existir esta opcion no lo traen y valen igual.
        && (!('soloCuentas' in data) || data.soloCuentas is bool)
        // Las salas viejas sin campo se interpretan como publicas durante la migracion.
        && (!('visibilidad' in data) || data.visibilidad in ['publica', 'privada'])
        && data.modoPrueba is bool
        && data.jugadoresEsperados is int
        && ((data.modoPrueba == true && data.jugadoresEsperados >= 3)
          || (data.modoPrueba == false && data.jugadoresEsperados >= 5))
        && data.jugadoresEsperados <= 15
        && data.maxJugadores is int
        && ((data.modoPrueba == true && data.maxJugadores >= 3)
          || (data.modoPrueba == false && data.maxJugadores >= 5))
        && data.maxJugadores <= 15
        && data.jugadoresActuales is int
        && data.jugadoresActuales >= 0
        && data.jugadoresActuales <= data.jugadoresEsperados
        && isString(data.origen, 1, 40)
        && (!('configLobby' in data) || validLobbyConfig(data.configLobby))
        && validLastResult(data);
    }

    function validRoomPostUpdate(data) {
      return validRoomBase(data);
    }

    function roomHost(partidaId) {
      return get(/databases/$(database)/documents/partidas/$(partidaId)).data.hostActivoId;
    }

    function roomStableHostAfter(partidaId) {
      return getAfter(/databases/$(database)/documents/partidas/$(partidaId)).data.hostId;
    }

    function isRoomStableHostAfter(partidaId) {
      return signedIn()
        && exists(/databases/$(database)/documents/partidas/$(partidaId))
        && roomStableHostAfter(partidaId) == request.auth.uid;
    }

    function cleanupDeleteAllowed(partidaId) {
      let room = get(/databases/$(database)/documents/partidas/$(partidaId)).data;
      return signedIn()
        && room.hostActivoId == request.auth.uid
        && room.estado == 'esperando'
        && room.limpiezaPendiente == true;
    }

    function roomTeardownAllowed(partidaId) {
      let room = get(/databases/$(database)/documents/partidas/$(partidaId)).data;
      return signedIn()
        && room.estado == 'esperando'
        && request.auth.uid == room.hostActivoId;
    }

    // Un creador que vuelve a entrar al online puede retirar sus propias salas huérfanas.
    // Se usa el timestamp del servidor, no el reloj del teléfono, y se espera un día entero
    // para no interferir con una partida o recuperación legítima todavía en curso.
    function staleCreatorCleanupAllowed(partidaId) {
      let room = get(/databases/$(database)/documents/partidas/$(partidaId)).data;
      return signedIn()
        && room.hostId == request.auth.uid
        && room.actualizadaEn is timestamp
        && request.time > room.actualizadaEn + duration.value(24, 'h');
    }

    function isActiveRoomMember(partidaId) {
      let playerPath = /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(request.auth.uid);
      return signedIn()
        && exists(playerPath)
        && get(playerPath).data.activoEnPartida != false;
    }

    // Al unirse, el documento del jugador y el contador de la sala se escriben en la misma
    // transaccion: `exists()` todavia no ve el alta, asi que hace falta el estado posterior.
    function isRoomMemberAfter(partidaId) {
      return signedIn()
        && existsAfter(
          /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(request.auth.uid)
        );
    }

    // Baneo global de la cuenta. Solo se escribe desde la consola de Firebase o con una
    // credencial de servicio; el cliente nunca puede crear ni borrar estos documentos.
    function isGloballyBanned() {
      return exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    // Baneo por sala aplicado por el anfitrion. Impide volver a entrar a esa sala.
    function isBannedFromRoom(partidaId) {
      return exists(
        /databases/$(database)/documents/partidas/$(partidaId)/baneados/$(request.auth.uid)
      );
    }

    function isRoomHostAny(partidaId) {
      let room = get(/databases/$(database)/documents/partidas/$(partidaId)).data;
      return signedIn() && request.auth.uid == room.hostActivoId;
    }

    // Cuenta real contra invitado.
    //
    // Se miran **las dos** señales a proposito: despues de `linkWithCredential` el claim
    // `sign_in_provider` puede seguir diciendo `anonymous` en el token que el cliente tiene en
    // mano hasta que se refresque, mientras que `email` aparece apenas hay token nuevo. El
    // cliente ademas fuerza `getIdToken(true)` al vincular (`AccountLink.refreshClaims`).
    function isRegistered() {
      return signedIn()
        && (
          request.auth.token.firebase.sign_in_provider != 'anonymous'
          || request.auth.token.get('email', '') != ''
        );
    }

    // Un invitado no escribe su nombre: elige un alias de una lista cerrada y el juego le
    // agrega un numero. Esta es la copia servidor de `GuestIdentity.aliases`: al tocar la
    // lista en Kotlin hay que tocarla aca, o el nombre nuevo se rechaza.
    function isValidGuestName(value) {
      return value is string
        && value.matches('^(Forastero|Mala Onda|Aguafiestas|Chamuyero|Careta|Mufa|Perejil|Metepatas|Don Nadie|El Colado|Sospechoso|Rezongón) [0-9]{4}$');
    }

    // Todo lo que un invitado puede mostrarle al resto de la mesa. Los avatares, banners y
    // roles favoritos salen de catalogos cerrados, asi que el unico texto libre que quedaba
    // era la frase: un invitado la publica vacia.
    function validGuestProfile(data) {
      return isValidGuestName(data.nombre)
        && (!('nombrePerfil' in data) || isValidGuestName(data.nombrePerfil))
        && (!('nombreSala' in data) || isValidGuestName(data.nombreSala))
        && (!('publicId' in data))
        && (!('bioPerfil' in data) || data.bioPerfil == '');
    }

    function lobbyChatDeleteAllowed(partidaId) {
      let room = get(/databases/$(database)/documents/partidas/$(partidaId)).data;
      return signedIn()
        && request.auth.uid in [room.hostId, room.hostActivoId]
        && room.estado in ['esperando', 'finalizada'];
    }

    function validCurrentMatchId(partidaId, matchId) {
      let room = get(/databases/$(database)/documents/partidas/$(partidaId)).data;
      return matchId is string
        && matchId.size() >= 8
        && matchId.size() <= 80
        && room.partidaInicialCreada == true
        && room.partidaInicial.matchId == matchId;
    }

    function isRoomActiveHost(partidaId) {
      return signedIn()
        && exists(/databases/$(database)/documents/partidas/$(partidaId))
        && roomHost(partidaId) == request.auth.uid;
    }

    function validActionActor(partidaId) {
      let room = get(/databases/$(database)/documents/partidas/$(partidaId)).data;
      let actorOrder = request.resource.data.detalles.actorOrden;
      let matchPlayers = room.partidaInicial.jugadores;
      return isActiveRoomMember(partidaId)
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorEsHost == isRoomActiveHost(partidaId)
        && actorOrder is int
        && matchPlayers is list
        && actorOrder >= 0
        && actorOrder < matchPlayers.size()
        // El orden que importa durante gameplay es el roster inmutable del match. El orden
        // del documento de lobby puede tener huecos o duplicarse tras una expulsión y un
        // reingreso; usarlo acá rechazaba acciones legítimas o atribuía un rol a otro UID.
        && matchPlayers[actorOrder].uidTemporal == request.auth.uid
        && matchPlayers[actorOrder].nombre == request.resource.data.actorNombre;
    }

    function activeHostCanUpdateRoom() {
      return signedIn()
        && request.auth.uid == resource.data.hostActivoId
        && request.resource.data.nombre == resource.data.nombre
        && request.resource.data.codigoSala == resource.data.codigoSala
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.hostNombre == resource.data.hostNombre
        && (
          request.resource.data.hostActivoId == resource.data.hostActivoId
          || (
            resource.data.estado in ['finalizada', 'en_juego']
            && request.resource.data.estado == 'esperando'
            && request.resource.data.hostActivoId == request.auth.uid
          )
        )
        && request.resource.data.hostVersion >= resource.data.hostVersion
        && request.resource.data.hostVersion <= resource.data.hostVersion + 1
        && request.resource.data.modoPrueba == resource.data.modoPrueba
        // Publica/privada se decide al crear. Cambiarla en caliente haria que el navegador
        // y el codigo compartido discrepen sobre quien puede descubrir la sala.
        && request.resource.data.get('visibilidad', 'publica')
          == resource.data.get('visibilidad', 'publica')
        && request.resource.data.origen == resource.data.origen
        // Volver una partida terminada al lobby tiene una rama especifica y devuelve la
        // autoridad al creador estable. El coordinador temporal no puede apropiarse de la
        // sala para la revancha mediante esta rama generica.
        && !(request.resource.data.estado == 'esperando'
          && resource.data.estado != 'esperando')
        && (!('partidaInicial' in request.resource.data)
          || request.resource.data.partidaInicial.mapa == request.resource.data.mapa);
    }

    function validPrivateInvestigationClue(clue) {
      return clue is map
        && hasOnly(clue, [
          'matchId', 'ronda', 'phaseIndex', 'objetivoNombre', 'resultado', 'actualizadaEn'
        ])
        && hasAll(clue, [
          'matchId', 'ronda', 'phaseIndex', 'objetivoNombre', 'resultado', 'actualizadaEn'
        ])
        && isString(clue.matchId, 8, 80)
        && clue.ronda is int
        && clue.ronda >= 0
        && clue.ronda <= 30
        && clue.phaseIndex is int
        && clue.phaseIndex >= 0
        && clue.phaseIndex <= 500
        && isString(clue.objetivoNombre, 1, 18)
        && clue.resultado in ['inocente', 'sospechoso']
        && clue.actualizadaEn == request.time;
    }

    function stableHostRematchReset() {
      return signedIn()
        && request.auth.uid == resource.data.hostId
        && resource.data.estado in ['finalizada', 'en_juego']
        && (
          resource.data.estado == 'finalizada'
          || (
            'estadoPartida' in resource.data
            && resource.data.estadoPartida.get('ganador', '') != ''
          )
        )
        && request.resource.data.estado == 'esperando'
        && changedOnly([
          'estado',
          'hostActivoId',
          'hostVersion',
          'partidaInicialCreada',
          'limpiezaPendiente',
          'partidaInicial',
          'estadoPartida',
          'estadoClientes',
          'entradaLiberadaMatchId',
          'jugadoresActuales',
          'actualizadaEn',
          'ultimaActividadOnline'
        ])
        && request.resource.data.hostActivoId == resource.data.hostId
        && request.resource.data.hostVersion == resource.data.hostVersion + 1
        && request.resource.data.partidaInicialCreada == false
        && request.resource.data.get('limpiezaPendiente', false) == true
        && !('partidaInicial' in request.resource.data)
        && !('estadoPartida' in request.resource.data)
        && !('estadoClientes' in request.resource.data)
        && !('entradaLiberadaMatchId' in request.resource.data)
        && request.resource.data.jugadoresActuales >= 1
        && request.resource.data.jugadoresActuales <= request.resource.data.jugadoresEsperados;
    }

    // Solo un jugador de esa sala puede mover el contador. Sin la membresia, cualquier
    // usuario autenticado podia alterar el conteo de salas ajenas.
    // Orden a proposito: primero los chequeos baratos que descartan la rama, y la membresia
    // al final. `allow update` encadena cinco ramas con `||` y Firestore corta la evaluacion a
    // las 1000 expresiones; poner una llamada de acceso adelante la cobra en cada update que
    // ni siquiera es de esta rama y acerca el techo para las ramas que vienen despues.
    function waitingPlayerCountUpdate(partidaId) {
      return resource.data.estado == 'esperando'
        && request.resource.data.estado == 'esperando'
        && changedOnly(['jugadoresActuales', 'actualizadaEn'])
        && request.resource.data.hostActivoId == resource.data.hostActivoId
        && request.resource.data.hostVersion == resource.data.hostVersion
        && request.resource.data.partidaInicialCreada == resource.data.partidaInicialCreada
        && request.resource.data.jugadoresActuales >= resource.data.jugadoresActuales - 1
        && request.resource.data.jugadoresActuales <= resource.data.jugadoresActuales + 1
        && isRoomMemberAfter(partidaId);
    }

    // El traspaso tecnico de anfitrion durante la partida. Exige ser jugador activo de esa
    // sala: sin ese chequeo, cualquier usuario autenticado podia tomar el `hostActivoId` de
    // una sala ajena y, con eso, editar jugadores, publicar estado falso o borrar la sala.
    function handoffUpdate(partidaId) {
      let previousHostPath = /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(resource.data.hostActivoId);
      let candidatePath = /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(request.auth.uid);
      return resource.data.estado == 'en_juego'
        && changedOnly(['hostActivoId', 'hostVersion', 'actualizadaEn'])
        && request.resource.data.hostActivoId == request.auth.uid
        && request.resource.data.hostActivoId != resource.data.hostActivoId
        && request.resource.data.hostVersion == resource.data.hostVersion + 1
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.partidaInicialCreada == resource.data.partidaInicialCreada
        && request.resource.data.jugadoresActuales == resource.data.jugadoresActuales
        && exists(previousHostPath)
        && get(previousHostPath).data.estado == 'desconectado'
        && get(previousHostPath).data.activoEnPartida != false
        && exists(candidatePath)
        && get(candidatePath).data.estado == 'conectado'
        && get(candidatePath).data.activoEnPartida != false;
    }

    function creatorIsStale(partidaId) {
      let path = /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(resource.data.hostId);
      return !exists(path)
        || get(path).data.activoEnPartida == false
        || (
          get(path).data.estado == 'desconectado'
          && get(path).data.ultimaConexion is timestamp
          && get(path).data.ultimaConexion <= request.time - duration.value(60, 's')
        );
    }

    function stableLobbyHostTransfer(partidaId) {
      let candidatePath = /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(request.resource.data.hostId);
      // El anfitrion estable de una sala tiene que tener cuenta: es la autoridad de la partida
      // y quien modera. En el lobby el corte es duro porque no hay nada que se congele; si no
      // queda ningun registrado, la sala se desarma como cuando no queda nadie.
      return isRegistered()
        && resource.data.estado in ['esperando', 'finalizada']
        && request.resource.data.estado == resource.data.estado
        && changedOnly([
          'hostId',
          'hostNombre',
          'hostActivoId',
          'hostVersion',
          'jugadoresActuales',
          'actualizadaEn'
        ])
        && request.resource.data.hostId != resource.data.hostId
        && request.resource.data.hostActivoId == request.resource.data.hostId
        && request.resource.data.hostVersion == resource.data.hostVersion + 1
        && request.resource.data.partidaInicialCreada == resource.data.partidaInicialCreada
        && request.resource.data.get('limpiezaPendiente', false)
          == resource.data.get('limpiezaPendiente', false)
        && request.resource.data.jugadoresEsperados == resource.data.jugadoresEsperados
        && request.resource.data.maxJugadores == resource.data.maxJugadores
        && request.resource.data.jugadoresActuales >= resource.data.jugadoresActuales - 1
        && request.resource.data.jugadoresActuales <= resource.data.jugadoresActuales
        && exists(candidatePath)
        && get(candidatePath).data.estado == 'conectado'
        && get(candidatePath).data.activoEnPartida != false
        // El que recibe la sala tampoco puede ser invitado. `isRegistered()` mira a quien
        // escribe, que en el traspaso del anfitrion saliente es otra persona; el `publicId`
        // es la señal en el documento, porque a un invitado las reglas no le dejan escribirlo.
        && 'publicId' in get(candidatePath).data
        && request.resource.data.hostNombre == get(candidatePath).data.nombre
        && (
          request.auth.uid == resource.data.hostId
          || (
            request.auth.uid == request.resource.data.hostId
            && creatorIsStale(partidaId)
          )
        );
    }

    // Compatibilidad temporal con APK de prueba anteriores. La version actual publica estos
    // ACK en RTDB; mantener esta rama barata evita romper clientes viejos y tambien descarta
    // rapidamente la mayoria de actualizaciones antes de evaluar ramas mas costosas.
    function clientStateSelfPublish(partidaId) {
      return signedIn()
        && changedOnly(['estadoClientes', 'ultimaActividadOnline'])
        && request.resource.data.get('estadoClientes', {})
          .diff(resource.data.get('estadoClientes', {}))
          .affectedKeys()
          .hasOnly([request.auth.uid])
        && exists(/databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(request.auth.uid));
    }

    function validPlayerDocument(data, uidTemporal) {
      return hasOnly(data, [
          'nombre',
          'nombrePerfil',
          'nombreSala',
          'publicId',
          'bioPerfil',
          'avatarPerfil',
          'fotoPlayGames',
          'bannerPerfil',
          'rolFavoritoPerfil',
          'esHost',
          'estado',
          'uidTemporal',
          'unidoEn',
          'ultimaConexion',
          'ultimaConexionLocal',
          'orden',
          'activoEnPartida',
          'listo',
          'listoParaVotar',
          'listoParaVotarRonda',
          'listoParaVotarPhaseIndex',
          'votoMapa'
        ])
        && hasAll(data, ['nombre', 'estado', 'uidTemporal'])
        && isString(data.nombre, 1, 18)
        && isOptionalString(data, 'nombrePerfil', 18)
        && isOptionalString(data, 'nombreSala', 32)
        && isOptionalString(data, 'bioPerfil', 40)
        && isOptionalString(data, 'avatarPerfil', 40)
        && isOptionalString(data, 'fotoPlayGames', 1000)
        && isOptionalString(data, 'bannerPerfil', 40)
        && isOptionalString(data, 'rolFavoritoPerfil', 40)
        && (!('publicId' in data) || validPublicId(data.publicId))
        && data.uidTemporal == uidTemporal
        && validPlayerState(data.estado)
        && (!('esHost' in data) || data.esHost is bool)
        && (!('activoEnPartida' in data) || data.activoEnPartida is bool)
        && (!('ultimaConexionLocal' in data) || data.ultimaConexionLocal is int)
        && (!('orden' in data) ||
          (data.orden is int &&
           data.orden >= 0 &&
           data.orden <= 14))
        && (!('listo' in data) || data.listo is bool)
        && (!('votoMapa' in data) || validMapKey(data.votoMapa))
        && (!('listoParaVotar' in data) || data.listoParaVotar is bool)
        && (!('listoParaVotarRonda' in data) ||
          (data.listoParaVotarRonda is int &&
           data.listoParaVotarRonda >= 0 &&
           data.listoParaVotarRonda <= 30))
        && (!('listoParaVotarPhaseIndex' in data) ||
          (data.listoParaVotarPhaseIndex is int &&
           data.listoParaVotarPhaseIndex >= 0 &&
           data.listoParaVotarPhaseIndex <= 500))
        // El chequeo mira a quien escribe, no al dueño del documento: el anfitrion (que tiene
        // cuenta) puede seguir editando el documento de un invitado al expulsarlo o al
        // liberar su cupo.
        && (isRegistered() || validGuestProfile(data));
    }

    // Boton "probar Firebase" de Opciones. Escribe siempre el mismo documento con la misma
    // forma (OpcionesActivity.writeFirestoreSmokeTest), asi que la regla se cierra a ese
    // documento y a esos campos: antes era escritura libre de cualquier documento y de
    // cualquier tamano para cualquier usuario autenticado.
    match /pruebas/{docId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && docId == 'conexion_inicial'
        && hasOnly(request.resource.data, [
          'nombre',
          'mensaje',
          'origen',
          'fechaLocal',
          'fechaServidor'
        ])
        && hasAll(request.resource.data, [
          'nombre',
          'mensaje',
          'origen',
          'fechaLocal',
          'fechaServidor'
        ])
        && isString(request.resource.data.nombre, 1, 40)
        && isString(request.resource.data.mensaje, 1, 140)
        && isString(request.resource.data.origen, 1, 40)
        && request.resource.data.fechaLocal is int
        && request.resource.data.fechaServidor == request.time;
    }

    // Baneo global de cuenta. Se crea a mano desde la consola de Firebase (o con una
    // credencial de servicio); ningun cliente puede escribir aca. Cada jugador solo lee el
    // suyo para poder mostrar el motivo en pantalla.
    match /bans/{uidBaneado} {
      allow read: if isSelf(uidBaneado);
      allow write: if false;
    }

    // Reportes inmutables y sin lectura desde el cliente. El id determinista evita que una
    // misma cuenta pueda inundar el backend reportando varias veces al mismo jugador por match.
    match /reportes/{reporteId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && reporteId == request.resource.data.matchId + '_'
          + request.auth.uid + '_' + request.resource.data.reportadoId
        && hasOnly(request.resource.data, [
          'reportanteId',
          'reportadoId',
          'reportadoNombre',
          'roomId',
          'matchId',
          'motivo',
          'detalle',
          'creadaEn'
        ])
        && hasAll(request.resource.data, [
          'reportanteId',
          'reportadoId',
          'reportadoNombre',
          'roomId',
          'matchId',
          'motivo',
          'creadaEn'
        ])
        && request.resource.data.reportanteId == request.auth.uid
        && request.resource.data.reportadoId != request.auth.uid
        && isString(request.resource.data.reportadoId, 1, 128)
        && isString(request.resource.data.reportadoNombre, 1, 18)
        && isString(request.resource.data.roomId, 1, 80)
        && isString(request.resource.data.matchId, 8, 80)
        && request.resource.data.motivo in [
          'toxicidad', 'trampa', 'spam', 'nombre_ofensivo', 'otro'
        ]
        && isOptionalString(request.resource.data, 'detalle', 140)
        && request.resource.data.creadaEn == request.time;
    }

    // Comentarios enviados desde el formulario interno. Son inmutables y nunca se pueden
    // consultar desde la app: solo el desarrollador los ve desde Firebase. La lista cerrada
    // de campos evita usar este buzón como almacenamiento arbitrario.
    match /comentarios/{comentarioId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && hasOnly(request.resource.data, [
          'uid',
          'nombre',
          'asunto',
          'mensaje',
          'destino',
          'estado',
          'origen',
          'version',
          'dispositivo',
          'android',
          'fechaLocal',
          'creadaEn'
        ])
        && hasAll(request.resource.data, [
          'uid',
          'nombre',
          'asunto',
          'mensaje',
          'destino',
          'estado',
          'origen',
          'version',
          'dispositivo',
          'android',
          'fechaLocal',
          'creadaEn'
        ])
        && request.resource.data.uid == request.auth.uid
        && isString(request.resource.data.nombre, 2, 40)
        && isString(request.resource.data.asunto, 3, 80)
        && isString(request.resource.data.mensaje, 10, 1200)
        && request.resource.data.destino == 'bandidogamesestudio@gmail.com'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.origen == 'formulario_app'
        && isString(request.resource.data.version, 0, 32)
        && isString(request.resource.data.dispositivo, 1, 100)
        && isString(request.resource.data.android, 1, 32)
        && request.resource.data.fechaLocal is int
        && request.resource.data.creadaEn == request.time;
    }

    // Reserva única de códigos. Solo se consulta por id exacto; no se puede enumerar para
    // descubrir códigos de salas privadas.
    match /codigosSala/{codigo} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isRegistered()
        && codigo == request.resource.data.codigoSala
        && validRoomCode(codigo)
        && hasOnly(request.resource.data, [
          'partidaId', 'codigoSala', 'hostId', 'creadaEn'
        ])
        && hasAll(request.resource.data, [
          'partidaId', 'codigoSala', 'hostId', 'creadaEn'
        ])
        && isString(request.resource.data.partidaId, 1, 80)
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.creadaEn == request.time
        && getAfter(
          /databases/$(database)/documents/partidas/$(request.resource.data.partidaId)
        ).data.codigoSala == codigo
        && getAfter(
          /databases/$(database)/documents/partidas/$(request.resource.data.partidaId)
        ).data.hostId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && (
          isRoomHostAny(resource.data.partidaId)
          || staleCreatorCleanupAllowed(resource.data.partidaId)
          || (
            !exists(/databases/$(database)/documents/partidas/$(resource.data.partidaId))
            && resource.data.hostId == request.auth.uid
          )
        );
    }

    match /partidas/{partidaId} {
      // Una sala en espera puede abrirse para entrar. Cuando comienza, solo sus miembros
      // conservan acceso al estado autoritativo.
      allow get: if signedIn()
        && (resource.data.estado == 'esperando' || isActiveRoomMember(partidaId));
      allow list: if signedIn()
        && (
          (
            resource.data.estado == 'esperando'
            && resource.data.get('visibilidad', 'publica') == 'publica'
          )
          // La app consulta solamente `hostId == request.auth.uid` para encontrar sus
          // propias salas viejas. No expone partidas privadas de otros creadores.
          || resource.data.hostId == request.auth.uid
        );

      // Crear sala es de cuentas registradas: el creador arranca de anfitrion, y el anfitrion
      // es la autoridad de la partida y quien expulsa y banea. Un invitado puede buscar salas
      // y entrar por codigo, pero no armar la suya.
      allow create: if isRegistered()
        && !isGloballyBanned()
        && validRoomBase(request.resource.data)
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.hostActivoId == request.auth.uid
        && request.resource.data.get('limpiezaPendiente', false) == false;

      allow update: if stableHostRematchReset()
        || (
          (
            clientStateSelfPublish(partidaId)
          || waitingPlayerCountUpdate(partidaId)
          || handoffUpdate(partidaId)
          || stableLobbyHostTransfer(partidaId)
          || activeHostCanUpdateRoom()
          )
          && validRoomPostUpdate(request.resource.data)
        );
      // El anfitrion (activo o estable) puede borrar la sala por completo cuando queda
      // vacia: esperando, y ya sin ningun otro jugador conectado (ese chequeo se hace en
      // el cliente antes de dejar el lobby; el ultimo anfitrion en pie es siempre quien
      // desencadena esto).
      allow delete: if signedIn()
        && (
          (
            resource.data.estado == 'esperando'
            && request.auth.uid == resource.data.hostActivoId
          )
          || staleCreatorCleanupAllowed(partidaId)
        );

      match /jugadores/{uidTemporal} {
        allow get: if isSelf(uidTemporal)
          || isActiveRoomMember(partidaId)
          || isRoomHostAny(partidaId)
          || staleCreatorCleanupAllowed(partidaId);
        allow list: if isActiveRoomMember(partidaId)
          || isRoomHostAny(partidaId)
          || staleCreatorCleanupAllowed(partidaId);

        // Los dos chequeos de baneo miran a `request.auth.uid`, o sea a quien escribe: el
        // anfitrion sigue pudiendo editar el documento del jugador que acaba de banear.
        allow create: if isSelf(uidTemporal)
          && !isGloballyBanned()
          && !isBannedFromRoom(partidaId)
          && validPlayerDocument(request.resource.data, uidTemporal);

        allow update: if (isSelf(uidTemporal)
          || isRoomActiveHost(partidaId)
          || isRoomStableHostAfter(partidaId))
          && !isGloballyBanned()
          && !isBannedFromRoom(partidaId)
          && validPlayerDocument(request.resource.data, uidTemporal);

        allow delete: if roomTeardownAllowed(partidaId)
          || staleCreatorCleanupAllowed(partidaId);
      }

      // Lista de expulsados permanentes de esta sala. La escribe el anfitrion (creador o
      // activo). El afectado puede consultar su propio baneo y el anfitrion administrar la
      // lista, pero los demas usuarios no pueden enumerarla.
      // El servidor la hace valer desde `jugadores`: sin esto el kick es una puerta giratoria.
      match /baneados/{uidBaneado} {
        allow get: if isSelf(uidBaneado)
          || isRoomHostAny(partidaId)
          || staleCreatorCleanupAllowed(partidaId);
        allow list: if isRoomHostAny(partidaId)
          || staleCreatorCleanupAllowed(partidaId);

        allow create: if isRoomHostAny(partidaId)
          && get(/databases/$(database)/documents/partidas/$(partidaId)).data.estado
            in ['esperando', 'finalizada']
          && uidBaneado != request.auth.uid
          && uidBaneado != get(/databases/$(database)/documents/partidas/$(partidaId)).data.hostId
          && hasOnly(request.resource.data, [
            'uidTemporal',
            'nombre',
            'motivo',
            'baneadoPor',
            'creadaEn'
          ])
          && hasAll(request.resource.data, ['uidTemporal', 'nombre', 'baneadoPor', 'creadaEn'])
          && request.resource.data.uidTemporal == uidBaneado
          && isString(request.resource.data.nombre, 1, 18)
          && isOptionalString(request.resource.data, 'motivo', 60)
          && request.resource.data.baneadoPor == request.auth.uid
          && request.resource.data.creadaEn == request.time;

        allow update: if false;
        allow delete: if isRoomHostAny(partidaId)
          || roomTeardownAllowed(partidaId)
          || staleCreatorCleanupAllowed(partidaId);
      }

      // Reparto privado: cada cliente solo puede leer su documento. El anfitrión activo
      // puede enumerarlos porque es quien ejecuta el motor autoritativo de la partida.
      match /repartos/{uidJugador} {
        allow get: if isSelf(uidJugador)
          || isRoomHostAny(partidaId)
          || staleCreatorCleanupAllowed(partidaId);
        allow list: if isRoomHostAny(partidaId)
          || staleCreatorCleanupAllowed(partidaId);
        allow create: if isRoomHostAny(partidaId)
          && hasOnly(request.resource.data, [
            'matchId', 'uidTemporal', 'rolesVisibles', 'creadaEn'
          ])
          && hasAll(request.resource.data, [
            'matchId', 'uidTemporal', 'rolesVisibles', 'creadaEn'
          ])
          && request.resource.data.uidTemporal == uidJugador
          && isString(request.resource.data.matchId, 8, 80)
          && request.resource.data.rolesVisibles is list
          && request.resource.data.rolesVisibles.size() >= 1
          && request.resource.data.rolesVisibles.size() <= 15
          && request.resource.data.creadaEn == request.time;
        // El anfitrion entrega al Detective su resultado sin publicar cartas ajenas. No puede
        // modificar el reparto original: solo agregar o reemplazar esta pista privada validada.
        allow update: if isRoomActiveHost(partidaId)
          && changedOnly(['pistaInvestigacion'])
          && validPrivateInvestigationClue(request.resource.data.pistaInvestigacion)
          && validCurrentMatchId(
            partidaId,
            request.resource.data.pistaInvestigacion.matchId
          );
        allow delete: if cleanupDeleteAllowed(partidaId)
          || roomTeardownAllowed(partidaId)
          || staleCreatorCleanupAllowed(partidaId);
      }

      match /acciones/{accionId} {
        // Cada participante confirma solo sus propias acciones. El anfitrión necesita el
        // conjunto completo para resolver la fase.
        allow read: if isRoomHostAny(partidaId)
          || staleCreatorCleanupAllowed(partidaId)
          || (
            isActiveRoomMember(partidaId)
            && resource.data.actorId == request.auth.uid
          );

        allow create: if validActionActor(partidaId)
          && !isGloballyBanned()
          && !isBannedFromRoom(partidaId)
          && get(/databases/$(database)/documents/partidas/$(partidaId)).data.estado == 'en_juego'
          && hasOnly(request.resource.data, [
            'matchId',
            'tipo',
            'actorId',
            'actorNombre',
            'actorEsHost',
            'objetivoNombre',
            'fase',
            'ronda',
            'phaseIndex',
            'modoCliente',
            'detalles',
            'creadaEn',
            'creadaEnLocal',
            'cambiosVoto'
          ])
          && hasAll(request.resource.data, [
            'matchId',
            'tipo',
            'actorId',
            'actorNombre',
            'actorEsHost',
            'objetivoNombre',
            'fase',
            'ronda',
            'phaseIndex',
            'modoCliente',
            'detalles',
            'creadaEn',
            'creadaEnLocal'
          ])
          && validCurrentMatchId(partidaId, request.resource.data.matchId)
          && (
            request.resource.data.tipo == 'accion_jugador'
            || (
              request.resource.data.tipo == 'fase_avanzada'
              && isRoomActiveHost(partidaId)
            )
          )
          && isString(request.resource.data.actorNombre, 1, 18)
          && request.resource.data.actorEsHost is bool
          && isOptionalString(request.resource.data, 'objetivoNombre', 18)
          && isString(request.resource.data.fase, 1, 40)
          && request.resource.data.ronda is int
          && request.resource.data.ronda >= 0
          && request.resource.data.ronda <= 30
          && request.resource.data.phaseIndex is int
          && request.resource.data.phaseIndex >= 0
          && request.resource.data.phaseIndex <= 500
          && isString(request.resource.data.modoCliente, 1, 30)
          && request.resource.data.detalles is map
          && request.resource.data.detalles.keys().hasOnly([
            'accion',
            'faseResultado',
            'phaseIndexResultado',
            'actorOrden',
            'objetivoOrden',
            'slotAccion',
            'bando',
            'faseNueva'
          ])
          && (
            request.resource.data.tipo == 'fase_avanzada'
            || isString(request.resource.data.detalles.accion, 1, 40)
          )
          // Compatibilidad con el APK anterior: aceptaba el contador en la creación.
          // Nunca se permite actualizar el documento, por lo que no agrega escrituras.
          && (
            !('cambiosVoto' in request.resource.data)
            || (
              request.resource.data.detalles.accion == 'votar'
              && request.resource.data.fase in ['VOTACION', 'DESEMPATE_VOTACION']
              && request.resource.data.cambiosVoto == 0
            )
          )
          && request.resource.data.creadaEnLocal is int
          && request.resource.data.creadaEn == request.time;

        // Cada acción se confirma una sola vez. En votación, cambiar cartas ocurre únicamente
        // en memoria local y nunca reemplaza el documento definitivo.
        allow update: if false;
        allow delete: if cleanupDeleteAllowed(partidaId)
          || roomTeardownAllowed(partidaId)
          || staleCreatorCleanupAllowed(partidaId);
      }

      match /chat/{mensajeId} {
        allow read: if isActiveRoomMember(partidaId)
          || staleCreatorCleanupAllowed(partidaId);

        allow create: if isActiveRoomMember(partidaId)
          && !isGloballyBanned()
          && !isBannedFromRoom(partidaId)
          && hasOnly(request.resource.data, [
            'matchId',
            'actorId',
            'speaker',
            'mensaje',
            'fase',
            'ronda',
            'isGod',
            'creadaEn',
            'creadaEnLocal'
          ])
          && validCurrentMatchId(partidaId, request.resource.data.matchId)
          && request.resource.data.actorId == request.auth.uid
          && isString(request.resource.data.speaker, 1, 18)
          && request.resource.data.speaker == get(
            /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(request.auth.uid)
          ).data.nombre
          && isString(request.resource.data.mensaje, 1, 140)
          && isString(request.resource.data.fase, 1, 40)
          && request.resource.data.ronda is int
          && request.resource.data.ronda >= 0
          && request.resource.data.ronda <= 30
          && request.resource.data.isGod == false
          && request.resource.data.creadaEnLocal is int;

        allow update: if false;
        allow delete: if cleanupDeleteAllowed(partidaId)
          || staleCreatorCleanupAllowed(partidaId);
      }

      match /chat_lobby/{mensajeId} {
        allow read: if isActiveRoomMember(partidaId)
          || staleCreatorCleanupAllowed(partidaId);

        allow create: if isActiveRoomMember(partidaId)
          && get(/databases/$(database)/documents/partidas/$(partidaId)).data.estado
            in ['esperando', 'finalizada']
          && hasOnly(request.resource.data, [
            'actorId',
            'speaker',
            'mensaje',
            'emoteId',
            'tipo',
            'creadaEn',
            'creadaEnLocal'
          ])
          && hasAll(request.resource.data, [
            'actorId',
            'speaker',
            'mensaje',
            'tipo',
            'creadaEn',
            'creadaEnLocal'
          ])
          && request.resource.data.actorId == request.auth.uid
          && isString(request.resource.data.speaker, 1, 18)
          && request.resource.data.speaker == get(
            /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(request.auth.uid)
          ).data.nombre
          && isString(request.resource.data.mensaje, 1, 140)
          && request.resource.data.tipo in ['texto', 'emote']
          && (
            (request.resource.data.tipo == 'texto' && !('emoteId' in request.resource.data))
            || (
              request.resource.data.tipo == 'emote'
              && isString(request.resource.data.emoteId, 1, 60)
            )
          )
          && request.resource.data.creadaEn == request.time
          && request.resource.data.creadaEnLocal is int;

        allow update: if false;
        allow delete: if lobbyChatDeleteAllowed(partidaId)
          || staleCreatorCleanupAllowed(partidaId);
      }

      match /chat_traidores/{mensajeId} {
        // El canal vigente vive en RTDB y se valida con la lista de acceso por rol. La copia
        // histórica de Firestore queda cerrada para no ofrecer una segunda puerta permisiva.
        allow read: if staleCreatorCleanupAllowed(partidaId);
        allow create, update: if false;
        allow delete: if cleanupDeleteAllowed(partidaId)
          || staleCreatorCleanupAllowed(partidaId);
      }
    }

    match /meta/public_ids {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'nextId',
          'actualizadaEn'
        ])
        && request.resource.data.nextId is int
        && request.resource.data.nextId >= 2
        && request.resource.data.nextId <= 999999999999;
      // Exactamente +1: PlayerPublicIdentity.ensurePublicId siempre reserva el siguiente
      // numero. Permitir cualquier salto hacia arriba dejaba que un solo cliente quemara
      // todo el espacio de `#` de una sola escritura.
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly([
          'nextId',
          'actualizadaEn'
        ])
        && request.resource.data.nextId is int
        && request.resource.data.nextId == resource.data.nextId + 1
        && request.resource.data.nextId <= 999999999999;
      allow delete: if false;
    }

    match /perfiles_publicos/{uidTemporal} {
      allow read: if signedIn();
      allow create, update: if isSelf(uidTemporal)
        && request.resource.data.keys().hasOnly([
          'uidTemporal',
          'publicId',
          'nombrePerfil',
          'nombreSala',
          'bioPerfil',
          'avatarPerfil',
          'fotoPlayGames',
          'bannerPerfil',
          'rolFavoritoPerfil',
          'actualizadaEn'
        ])
        && request.resource.data.uidTemporal == uidTemporal
        && validPublicId(request.resource.data.publicId)
        && isString(request.resource.data.nombrePerfil, 1, 18)
        && isOptionalString(request.resource.data, 'nombreSala', 32)
        && isOptionalString(request.resource.data, 'bioPerfil', 40)
        && isOptionalString(request.resource.data, 'avatarPerfil', 40)
        && isOptionalString(request.resource.data, 'fotoPlayGames', 1000)
        && isOptionalString(request.resource.data, 'bannerPerfil', 40)
        && isOptionalString(request.resource.data, 'rolFavoritoPerfil', 40);
      // El dueño necesita borrar su perfil antes de eliminar Firebase Auth. Si se cerrara
      // primero la cuenta, perdería el permiso y el documento quedaría huérfano.
      allow delete: if isSelf(uidTemporal);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

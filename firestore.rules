rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasOnly(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function hasAll(data, fields) {
      return data.keys().hasAll(fields);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOptionalString(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    function validRoomCode(code) {
      return code is string && code.matches('^[A-HJ-NP-Z2-9]{6}$');
    }

    function validRoomState(state) {
      return state in ['esperando', 'en_juego', 'abandonada', 'finalizada'];
    }

    function validPlayerState(state) {
      return state in ['conectado', 'desconectado', 'listo'];
    }

    function validPublicId(publicId) {
      return publicId is string && publicId.matches('^[0-9]{1,12}$');
    }

    function validMapKey(mapKey) {
      return mapKey in ['pampa', 'grecia', 'medieval'];
    }

    function validLobbyConfig(config) {
      return config is map
        && hasOnly(config, [
          'transicionSeg',
          'nocheSeg',
          'discusionSeg',
          'votacionSeg',
          'revelarRolesAlMorir',
          'votosIndividuales'
        ])
        && config.transicionSeg is int
        && config.transicionSeg >= 1
        && config.transicionSeg <= 10
        && config.nocheSeg is int
        && config.nocheSeg >= 10
        && config.nocheSeg <= 90
        && config.discusionSeg is int
        && config.discusionSeg >= 30
        && config.discusionSeg <= 180
        && config.votacionSeg is int
        && config.votacionSeg >= 10
        && config.votacionSeg <= 60
        && config.revelarRolesAlMorir is bool
        && config.votosIndividuales is bool;
    }

    function validLastResult(data) {
      return !('ultimoResultado' in data)
        || (
          data.ultimoResultado is map
          && hasOnly(data.ultimoResultado, [
            'ganador', 'ronda', 'mapa', 'matchId', 'finalizadaEnLocal'
          ])
          && isString(data.ultimoResultado.ganador, 1, 40)
          && data.ultimoResultado.ronda is int
          && data.ultimoResultado.ronda >= 0
          && data.ultimoResultado.ronda <= 30
          && validMapKey(data.ultimoResultado.mapa)
          && isString(data.ultimoResultado.matchId, 8, 80)
          && data.ultimoResultado.finalizadaEnLocal is int
        );
    }

    function validRoomBase(data) {
      return isString(data.nombre, 1, 60)
        && validRoomCode(data.codigoSala)
        && validRoomState(data.estado)
        && validMapKey(data.mapa)
        && isString(data.mapaNombre, 1, 40)
        && isString(data.hostId, 1, 80)
        && isString(data.hostNombre, 1, 18)
        && isString(data.hostActivoId, 1, 80)
        && data.hostVersion is int
        && data.hostVersion >= 0
        && data.partidaInicialCreada is bool
        && (!('limpiezaPendiente' in data) || data.limpiezaPendiente is bool)
        && data.modoPrueba is bool
        && data.jugadoresEsperados is int
        && ((data.modoPrueba == true && data.jugadoresEsperados >= 3)
          || (data.modoPrueba == false && data.jugadoresEsperados >= 5))
        && data.jugadoresEsperados <= 15
        && data.maxJugadores is int
        && ((data.modoPrueba == true && data.maxJugadores >= 3)
          || (data.modoPrueba == false && data.maxJugadores >= 5))
        && data.maxJugadores <= 15
        && data.jugadoresActuales is int
        && data.jugadoresActuales >= 0
        && data.jugadoresActuales <= data.jugadoresEsperados
        && isString(data.origen, 1, 40)
        && (!('configLobby' in data) || validLobbyConfig(data.configLobby))
        && validLastResult(data);
    }

    function validRoomPostUpdate(data) {
      return validRoomBase(data);
    }

    function roomHost(partidaId) {
      return get(/databases/$(database)/documents/partidas/$(partidaId)).data.hostActivoId;
    }

    function roomStableHostAfter(partidaId) {
      return getAfter(/databases/$(database)/documents/partidas/$(partidaId)).data.hostId;
    }

    function isRoomStableHostAfter(partidaId) {
      return signedIn()
        && exists(/databases/$(database)/documents/partidas/$(partidaId))
        && roomStableHostAfter(partidaId) == request.auth.uid;
    }

    function cleanupDeleteAllowed(partidaId) {
      let room = get(/databases/$(database)/documents/partidas/$(partidaId)).data;
      return signedIn()
        && room.hostId == request.auth.uid
        && room.estado == 'esperando'
        && room.limpiezaPendiente == true;
    }

    function roomTeardownAllowed(partidaId) {
      let room = get(/databases/$(database)/documents/partidas/$(partidaId)).data;
      return signedIn()
        && room.estado == 'esperando'
        && request.auth.uid in [room.hostId, room.hostActivoId];
    }

    function isActiveRoomMember(partidaId) {
      let playerPath = /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(request.auth.uid);
      return signedIn()
        && exists(playerPath)
        && get(playerPath).data.activoEnPartida != false;
    }

    function lobbyChatDeleteAllowed(partidaId) {
      let room = get(/databases/$(database)/documents/partidas/$(partidaId)).data;
      return signedIn()
        && request.auth.uid in [room.hostId, room.hostActivoId]
        && room.estado in ['esperando', 'finalizada'];
    }

    function validCurrentMatchId(partidaId, matchId) {
      let room = get(/databases/$(database)/documents/partidas/$(partidaId)).data;
      return matchId is string
        && matchId.size() >= 8
        && matchId.size() <= 80
        && room.partidaInicialCreada == true
        && room.partidaInicial.matchId == matchId;
    }

    function isRoomActiveHost(partidaId) {
      return signedIn()
        && exists(/databases/$(database)/documents/partidas/$(partidaId))
        && roomHost(partidaId) == request.auth.uid;
    }

    function activeHostCanUpdateRoom() {
      return signedIn()
        && request.auth.uid in [resource.data.hostActivoId, resource.data.hostId]
        && request.resource.data.nombre == resource.data.nombre
        && request.resource.data.codigoSala == resource.data.codigoSala
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.hostNombre == resource.data.hostNombre
        && (
          request.resource.data.hostActivoId == resource.data.hostActivoId
          || (
            request.auth.uid == resource.data.hostId
            && resource.data.estado in ['finalizada', 'en_juego']
            && request.resource.data.estado == 'esperando'
            && request.resource.data.hostActivoId == request.auth.uid
          )
        )
        && request.resource.data.hostVersion >= resource.data.hostVersion
        && request.resource.data.hostVersion <= resource.data.hostVersion + 1
        && request.resource.data.modoPrueba == resource.data.modoPrueba
        && request.resource.data.origen == resource.data.origen
        && (!(request.resource.data.estado == 'esperando'
          && resource.data.estado != 'esperando') || request.auth.uid == resource.data.hostId)
        && (!('partidaInicial' in request.resource.data)
          || request.resource.data.partidaInicial.mapa == request.resource.data.mapa);
    }

    function waitingPlayerCountUpdate() {
      return signedIn()
        && resource.data.estado == 'esperando'
        && request.resource.data.estado == 'esperando'
        && changedOnly(['jugadoresActuales', 'actualizadaEn'])
        && request.resource.data.hostActivoId == resource.data.hostActivoId
        && request.resource.data.hostVersion == resource.data.hostVersion
        && request.resource.data.partidaInicialCreada == resource.data.partidaInicialCreada
        && request.resource.data.jugadoresActuales >= resource.data.jugadoresActuales - 1
        && request.resource.data.jugadoresActuales <= resource.data.jugadoresActuales + 1;
    }

    function handoffUpdate() {
      return signedIn()
        && changedOnly(['hostActivoId', 'hostVersion', 'actualizadaEn'])
        && request.resource.data.hostActivoId == request.auth.uid
        && request.resource.data.hostActivoId != resource.data.hostActivoId
        && request.resource.data.hostVersion == resource.data.hostVersion + 1
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.partidaInicialCreada == resource.data.partidaInicialCreada
        && request.resource.data.jugadoresActuales == resource.data.jugadoresActuales;
    }

    function creatorIsStale(partidaId) {
      let path = /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(resource.data.hostId);
      return !exists(path)
        || get(path).data.activoEnPartida == false
        || (
          get(path).data.estado == 'desconectado'
          && get(path).data.ultimaConexion is timestamp
          && get(path).data.ultimaConexion <= request.time - duration.value(60, 's')
        );
    }

    function stableLobbyHostTransfer(partidaId) {
      let candidatePath = /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(request.resource.data.hostId);
      return signedIn()
        && resource.data.estado in ['esperando', 'finalizada']
        && request.resource.data.estado == resource.data.estado
        && changedOnly([
          'hostId',
          'hostNombre',
          'hostActivoId',
          'hostVersion',
          'jugadoresActuales',
          'actualizadaEn'
        ])
        && request.resource.data.hostId != resource.data.hostId
        && request.resource.data.hostActivoId == request.resource.data.hostId
        && request.resource.data.hostVersion == resource.data.hostVersion + 1
        && request.resource.data.partidaInicialCreada == resource.data.partidaInicialCreada
        && request.resource.data.get('limpiezaPendiente', false)
          == resource.data.get('limpiezaPendiente', false)
        && request.resource.data.jugadoresEsperados == resource.data.jugadoresEsperados
        && request.resource.data.maxJugadores == resource.data.maxJugadores
        && request.resource.data.jugadoresActuales >= resource.data.jugadoresActuales - 1
        && request.resource.data.jugadoresActuales <= resource.data.jugadoresActuales
        && exists(candidatePath)
        && get(candidatePath).data.estado == 'conectado'
        && get(candidatePath).data.activoEnPartida != false
        && request.resource.data.hostNombre == get(candidatePath).data.nombre
        && (
          request.auth.uid == resource.data.hostId
          || (
            request.auth.uid == request.resource.data.hostId
            && creatorIsStale(partidaId)
          )
        );
    }

    function clientStateSelfPublish(partidaId) {
      return signedIn()
        && changedOnly(['estadoClientes', 'ultimaActividadOnline'])
        && request.resource.data.get('estadoClientes', {})
          .diff(resource.data.get('estadoClientes', {}))
          .affectedKeys()
          .hasOnly([request.auth.uid])
        && exists(/databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(request.auth.uid));
    }

    function validPlayerDocument(data, uidTemporal) {
      return hasOnly(data, [
          'nombre',
          'nombrePerfil',
          'nombreSala',
          'publicId',
          'bioPerfil',
          'avatarPerfil',
          'bannerPerfil',
          'rolFavoritoPerfil',
          'esHost',
          'estado',
          'uidTemporal',
          'unidoEn',
          'ultimaConexion',
          'ultimaConexionLocal',
          'orden',
          'activoEnPartida',
          'listo',
          'listoParaVotar',
          'listoParaVotarRonda',
          'listoParaVotarPhaseIndex',
          'votoMapa'
        ])
        && hasAll(data, ['nombre', 'estado', 'uidTemporal'])
        && isString(data.nombre, 1, 18)
        && isOptionalString(data, 'nombrePerfil', 18)
        && isOptionalString(data, 'nombreSala', 32)
        && isOptionalString(data, 'bioPerfil', 40)
        && isOptionalString(data, 'avatarPerfil', 40)
        && isOptionalString(data, 'bannerPerfil', 40)
        && isOptionalString(data, 'rolFavoritoPerfil', 40)
        && (!('publicId' in data) || validPublicId(data.publicId))
        && data.uidTemporal == uidTemporal
        && validPlayerState(data.estado)
        && (!('esHost' in data) || data.esHost is bool)
        && (!('activoEnPartida' in data) || data.activoEnPartida is bool)
        && (!('ultimaConexionLocal' in data) || data.ultimaConexionLocal is int)
        && (!('orden' in data) ||
          (data.orden is int &&
           data.orden >= 0 &&
           data.orden <= 14))
        && (!('listo' in data) || data.listo is bool)
        && (!('votoMapa' in data) || validMapKey(data.votoMapa))
        && (!('listoParaVotar' in data) || data.listoParaVotar is bool)
        && (!('listoParaVotarRonda' in data) ||
          (data.listoParaVotarRonda is int &&
           data.listoParaVotarRonda >= 0 &&
           data.listoParaVotarRonda <= 30))
        && (!('listoParaVotarPhaseIndex' in data) ||
          (data.listoParaVotarPhaseIndex is int &&
           data.listoParaVotarPhaseIndex >= 0 &&
           data.listoParaVotarPhaseIndex <= 500));
    }

    match /pruebas/{docId} {
      allow read, write: if true;
    }

    match /partidas/{partidaId} {
      allow read: if true;

      allow create: if signedIn()
        && validRoomBase(request.resource.data)
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.hostActivoId == request.auth.uid
        && request.resource.data.get('limpiezaPendiente', false) == false;

      allow update: if validRoomPostUpdate(request.resource.data)
        && (
          activeHostCanUpdateRoom()
          || clientStateSelfPublish(partidaId)
          || waitingPlayerCountUpdate()
          || handoffUpdate()
          || stableLobbyHostTransfer(partidaId)
        );
      // El anfitrion (activo o estable) puede borrar la sala por completo cuando queda
      // vacia: esperando, y ya sin ningun otro jugador conectado (ese chequeo se hace en
      // el cliente antes de dejar el lobby; el ultimo anfitrion en pie es siempre quien
      // desencadena esto).
      allow delete: if signedIn()
        && resource.data.estado == 'esperando'
        && request.auth.uid in [resource.data.hostId, resource.data.hostActivoId];

      match /jugadores/{uidTemporal} {
        allow read: if true;

        allow create: if isSelf(uidTemporal)
          && validPlayerDocument(request.resource.data, uidTemporal);

        allow update: if (isSelf(uidTemporal)
          || isRoomActiveHost(partidaId)
          || isRoomStableHostAfter(partidaId))
          && validPlayerDocument(request.resource.data, uidTemporal);

        allow delete: if roomTeardownAllowed(partidaId);
      }

      match /acciones/{accionId} {
        allow read: if true;

        allow create: if signedIn()
          && hasOnly(request.resource.data, [
            'matchId',
            'tipo',
            'actorId',
            'actorNombre',
            'actorEsHost',
            'objetivoNombre',
            'fase',
            'ronda',
            'phaseIndex',
            'modoCliente',
            'detalles',
            'creadaEn',
            'creadaEnLocal'
          ])
          && validCurrentMatchId(partidaId, request.resource.data.matchId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.tipo in ['accion_jugador', 'fase_avanzada']
          && isString(request.resource.data.actorNombre, 1, 18)
          && request.resource.data.actorEsHost is bool
          && isOptionalString(request.resource.data, 'objetivoNombre', 18)
          && isString(request.resource.data.fase, 1, 40)
          && request.resource.data.ronda is int
          && request.resource.data.ronda >= 0
          && request.resource.data.ronda <= 30
          && request.resource.data.phaseIndex is int
          && request.resource.data.phaseIndex >= 0
          && request.resource.data.phaseIndex <= 500
          && isString(request.resource.data.modoCliente, 1, 30)
          && request.resource.data.detalles is map
          && request.resource.data.creadaEnLocal is int;

        allow update: if false;
        allow delete: if cleanupDeleteAllowed(partidaId) || roomTeardownAllowed(partidaId);
      }

      match /chat/{mensajeId} {
        allow read: if true;

        allow create: if signedIn()
          && hasOnly(request.resource.data, [
            'matchId',
            'actorId',
            'speaker',
            'mensaje',
            'fase',
            'ronda',
            'isGod',
            'creadaEn',
            'creadaEnLocal'
          ])
          && validCurrentMatchId(partidaId, request.resource.data.matchId)
          && request.resource.data.actorId == request.auth.uid
          && isString(request.resource.data.speaker, 1, 18)
          && isString(request.resource.data.mensaje, 1, 140)
          && isString(request.resource.data.fase, 1, 40)
          && request.resource.data.ronda is int
          && request.resource.data.ronda >= 0
          && request.resource.data.ronda <= 30
          && request.resource.data.isGod == false
          && request.resource.data.creadaEnLocal is int;

        allow update: if false;
        allow delete: if cleanupDeleteAllowed(partidaId);
      }

      match /chat_lobby/{mensajeId} {
        allow read: if isActiveRoomMember(partidaId);

        allow create: if isActiveRoomMember(partidaId)
          && get(/databases/$(database)/documents/partidas/$(partidaId)).data.estado
            in ['esperando', 'finalizada']
          && hasOnly(request.resource.data, [
            'actorId',
            'speaker',
            'mensaje',
            'emoteId',
            'tipo',
            'creadaEn',
            'creadaEnLocal'
          ])
          && hasAll(request.resource.data, [
            'actorId',
            'speaker',
            'mensaje',
            'tipo',
            'creadaEn',
            'creadaEnLocal'
          ])
          && request.resource.data.actorId == request.auth.uid
          && isString(request.resource.data.speaker, 1, 18)
          && request.resource.data.speaker == get(
            /databases/$(database)/documents/partidas/$(partidaId)/jugadores/$(request.auth.uid)
          ).data.nombre
          && isString(request.resource.data.mensaje, 1, 140)
          && request.resource.data.tipo in ['texto', 'emote']
          && (
            (request.resource.data.tipo == 'texto' && !('emoteId' in request.resource.data))
            || (
              request.resource.data.tipo == 'emote'
              && isString(request.resource.data.emoteId, 1, 60)
            )
          )
          && request.resource.data.creadaEn == request.time
          && request.resource.data.creadaEnLocal is int;

        allow update: if false;
        allow delete: if lobbyChatDeleteAllowed(partidaId);
      }

      match /chat_traidores/{mensajeId} {
        // Canal secreto del equipo asesino. Hoy la lectura es honor-system, igual que el
        // secreto de roles en online (partidaInicial es world-readable). Para cerrar la
        // lectura a nivel servidor, reemplazar `allow read: if true` por una funcion que
        // haga get() sobre partidaInicial y verifique que request.auth.uid tiene un rol
        // traidor. Requiere confirmar el shape del rol por uid en partidaInicial.
        allow read: if true;

        allow create: if signedIn()
          && hasOnly(request.resource.data, [
            'matchId',
            'actorId',
            'speaker',
            'mensaje',
            'fase',
            'ronda',
            'isGod',
            'canal',
            'creadaEn',
            'creadaEnLocal'
          ])
          && validCurrentMatchId(partidaId, request.resource.data.matchId)
          && request.resource.data.actorId == request.auth.uid
          && isString(request.resource.data.speaker, 1, 18)
          && isString(request.resource.data.mensaje, 1, 140)
          && isString(request.resource.data.fase, 1, 40)
          && request.resource.data.ronda is int
          && request.resource.data.ronda >= 0
          && request.resource.data.ronda <= 30
          && request.resource.data.isGod == false
          && request.resource.data.canal == 'traidores'
          && request.resource.data.creadaEnLocal is int;

        allow update: if false;
        allow delete: if cleanupDeleteAllowed(partidaId);
      }
    }

    match /meta/public_ids {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'nextId',
          'actualizadaEn'
        ])
        && request.resource.data.nextId is int
        && request.resource.data.nextId >= 2
        && request.resource.data.nextId <= 999999999999;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly([
          'nextId',
          'actualizadaEn'
        ])
        && request.resource.data.nextId is int
        && request.resource.data.nextId > resource.data.nextId
        && request.resource.data.nextId <= 999999999999;
      allow delete: if false;
    }

    match /perfiles_publicos/{uidTemporal} {
      allow read: if true;
      allow create, update: if isSelf(uidTemporal)
        && request.resource.data.keys().hasOnly([
          'uidTemporal',
          'publicId',
          'nombrePerfil',
          'nombreSala',
          'bioPerfil',
          'avatarPerfil',
          'bannerPerfil',
          'rolFavoritoPerfil',
          'actualizadaEn'
        ])
        && request.resource.data.uidTemporal == uidTemporal
        && validPublicId(request.resource.data.publicId)
        && isString(request.resource.data.nombrePerfil, 1, 18)
        && isOptionalString(request.resource.data, 'nombreSala', 32)
        && isOptionalString(request.resource.data, 'bioPerfil', 40)
        && isOptionalString(request.resource.data, 'avatarPerfil', 40)
        && isOptionalString(request.resource.data, 'bannerPerfil', 40)
        && isOptionalString(request.resource.data, 'rolFavoritoPerfil', 40);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

          "proponenteUid": { ".validate": "newData.val() === auth.uid" },
          "proponenteNombre": { ".validate": "newData.val() === root.child('salas').child($roomId).child('miembros').child(auth.uid).child('nombre').val()" },
          "ts": { ".validate": "newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now" },
          "$other": { ".validate": false }
        },
        "votos_silencio": {
          ".read": "auth != null && root.child('salas').child($roomId).child('miembros').child(auth.uid).child('activo').val() === true",
          ".write": "auth != null && !newData.exists() && root.child('salas').child($roomId).child('control').child('hostUid').val() === auth.uid",
          "$targetUid": {
            "$voterUid": {
              ".write": "auth != null && auth.uid === $voterUid && $targetUid !== auth.uid && !data.exists() && root.child('salas').child($roomId).child('miembros').child(auth.uid).child('activo').val() === true && root.child('salas').child($roomId).child('miembros').child(auth.uid).child('vivo').val() === true && root.child('salas').child($roomId).child('propuesta_silencio').child('objetivoUid').val() === $targetUid",
              ".validate": "newData.isNumber() && newData.val() >= root.child('salas').child($roomId).child('propuesta_silencio').child('ts').val() && newData.val() <= now"
            }
          }
        },
        "silenciados": {
          ".read": "auth != null && root.child('salas').child($roomId).child('miembros').child(auth.uid).child('activo').val() === true",
          ".write": "auth != null && !newData.exists() && root.child('salas').child($roomId).child('control').child('hostUid').val() === auth.uid",
          "$targetUid": {
            ".write": "auth != null && root.child('salas').child($roomId).child('control').child('hostUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['ts', 'votos']) && root.child('salas').child($roomId).child('propuesta_silencio').child('objetivoUid').val() === $targetUid",
            "ts": { ".validate": "newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now" },
            "votos": { ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 15" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}

{
  "rules": {
    ".read": false,
    ".write": false,
    "salas": {
      "$roomId": {
        ".write": "auth != null && !newData.exists() && data.child('presencia').child(auth.uid).exists()",
        "chat": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()",
          "$messageId": {
            ".write": "auth != null && ((!data.exists() && newData.child('actorId').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['matchId', 'actorId', 'speaker', 'mensaje', 'fase', 'ronda', 'isGod', 'ts'])",
            "matchId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "actorId": { ".validate": "newData.val() === auth.uid" },
            "speaker": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 18" },
            "mensaje": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140" },
            "fase": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "ronda": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30" },
            "isGod": { ".validate": "newData.val() === false" },
            "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "chat_traidores": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()",
          "$messageId": {
            ".write": "auth != null && ((!data.exists() && newData.child('actorId').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['matchId', 'actorId', 'speaker', 'mensaje', 'fase', 'ronda', 'isGod', 'canal', 'ts'])",
            "matchId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "actorId": { ".validate": "newData.val() === auth.uid" },
            "speaker": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 18" },
            "mensaje": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140" },
            "fase": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "ronda": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30" },
            "isGod": { ".validate": "newData.val() === false" },
            "canal": { ".validate": "newData.val() === 'traidores'" },
            "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "chat_espectadores": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()",
          "$messageId": {
            ".write": "auth != null && ((!data.exists() && newData.child('actorId').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['matchId', 'actorId', 'speaker', 'mensaje', 'fase', 'ronda', 'isGod', 'canal', 'ts'])",
            "matchId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "actorId": { ".validate": "newData.val() === auth.uid" },
            "speaker": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 18" },
            "mensaje": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140" },
            "fase": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "ronda": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30" },
            "isGod": { ".validate": "newData.val() === false" },
            "canal": { ".validate": "newData.val() === 'espectadores'" },
            "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "emotes": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()",
          "$emoteEventId": {
            ".write": "auth != null && ((!data.exists() && newData.child('actorId').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['matchId', 'actorId', 'player', 'emoteId', 'ts'])",
            "matchId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "actorId": { ".validate": "newData.val() === auth.uid" },
            "player": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 18" },
            "emoteId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "chat_lobby": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()",
          "$messageId": {
            ".write": "auth != null && ((!data.exists() && newData.child('actorId').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['actorId', 'speaker', 'mensaje', 'tipo', 'ts']) && ((newData.child('tipo').val() === 'texto' && !newData.hasChild('emoteId')) || (newData.child('tipo').val() === 'emote' && newData.hasChild('emoteId')))",
            "actorId": { ".validate": "newData.val() === auth.uid" },
            "speaker": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 18" },
            "mensaje": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140" },
            "tipo": { ".validate": "newData.val() === 'texto' || newData.val() === 'emote'" },
            "emoteId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "presencia": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['estado', 'ts'])",
            "estado": { ".validate": "newData.val() === 'conectado' || newData.val() === 'desconectado'" },
            "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}

            "emoteId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "presencia": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['estado', 'ts'])",
            "estado": { ".validate": "newData.val() === 'conectado' || newData.val() === 'desconectado'" },
            "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "propuesta_silencio": {
          ".read": "auth != null && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()",
          ".write": "auth != null && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists() && newData.child('proponenteUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['objetivoUid', 'objetivoNombre', 'proponenteUid', 'proponenteNombre', 'ts']) && newData.child('objetivoUid').val() !== auth.uid && root.child('salas').child($roomId).child('presencia').child(newData.child('objetivoUid').val()).exists()",
          "objetivoUid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
          "objetivoNombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 18" },
          "proponenteUid": { ".validate": "newData.val() === auth.uid" },
          "proponenteNombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 18" },
          "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        },
        "votos_silencio": {
          ".read": "auth != null && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()",
          "$targetUid": {
            "$voterUid": {
              ".write": "auth != null && auth.uid === $voterUid && $targetUid !== auth.uid && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists() && root.child('salas').child($roomId).child('propuesta_silencio').child('objetivoUid').val() === $targetUid",
              ".validate": "newData.isNumber() && newData.val() <= now"
            }
          }
        },
        "silenciados": {
          ".read": "auth != null && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists()",
          "$targetUid": {
            ".write": "auth != null && root.child('salas').child($roomId).child('presencia').child(auth.uid).exists() && root.child('salas').child($roomId).child('propuesta_silencio').child('objetivoUid').val() === $targetUid",
            ".validate": "newData.hasChildren(['ts', 'votos'])",
            "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "votos": { ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 15" },
            "$other": { ".validate": false }
          }
        }

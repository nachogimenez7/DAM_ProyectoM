<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bree_serif"
        android:gravity="center"
        android:text="ÚLTIMAS PARTIDAS"
        android:textColor="@color/accent_gold"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/matchHistorySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="Tus últimas 5 partidas locales finalizadas"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/matchHistoryScroll"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="12dp"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/matchHistoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnCloseMatchHistory"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_gold"
        android:fontFamily="sans-serif"
        android:text="CERRAR"
        android:textColor="@color/bg_dark"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>

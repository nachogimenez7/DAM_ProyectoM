<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_menu" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#52000000" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="14dp"
        android:background="@drawable/bg_btn_dark"
        android:contentDescription="Volver"
        android:padding="10dp"
        android:src="@android:drawable/ic_media_previous"
        app:tint="@color/text_secondary" />

    <ScrollView
        android:id="@+id/optionsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnBack"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/bree_serif"
                android:letterSpacing="0.03"
                android:text="OPCIONES"
                android:textColor="@color/accent_gold"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitleOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="22dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Ajusta el juego para que sea comodo de leer y escuchar."
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/titleAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/bree_serif"
                android:text="SONIDO Y RESPUESTA"
                android:textColor="@color/accent_gold"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_btn_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMusic"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:text="Musica"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:thumb="@drawable/switch_thumb_traidores"
                    android:track="@drawable/switch_track_traidores"
                    app:showText="false" />

                <TextView
                    android:id="@+id/descSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:fontFamily="sans-serif"
                    android:text="Controla por separado la musica y los efectos del juego."
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/labelMusic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Musica: 80%"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <SeekBar
                    android:id="@+id/seekMusic"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:max="100"
                    android:progress="80"
                    android:progressTint="@color/accent_gold"
                    android:thumbTint="@color/accent_gold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEffects"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:text="Efectos de sonido"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:thumb="@drawable/switch_thumb_traidores"
                    android:track="@drawable/switch_track_traidores"
                    app:showText="false" />

                <TextView
                    android:id="@+id/labelVoices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Efectos: 80%"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <SeekBar
                    android:id="@+id/seekVoices"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:max="100"
                    android:progress="80"
                    android:progressTint="@color/accent_gold"
                    android:thumbTint="@color/accent_gold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchVibration"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:text="Vibracion al interactuar"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:thumb="@drawable/switch_thumb_traidores"
                    android:track="@drawable/switch_track_traidores"
                    app:showText="false" />

            </LinearLayout>

            <TextView
                android:id="@+id/titleTextSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif"
                android:text="LECTURA Y ACCESIBILIDAD"
                android:textColor="@color/accent_gold"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_btn_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/labelTextSize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="Tamano del texto"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <Spinner
                        android:id="@+id/spinnerTextSize"
                        android:layout_width="156dp"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/accent_gold"
                        android:popupBackground="@color/bg_card"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <TextView
                    android:id="@+id/descTextSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Se aplica a mensajes, botones y datos durante la partida."
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textSizePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_btn_dark"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="10dp"
                    android:text="El pueblo despierta. Escucha, debate y decide."
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="italic" />

            </LinearLayout>

            <TextView
                android:id="@+id/titleLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif"
                android:text="IDIOMA"
                android:textColor="@color/accent_gold"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_btn_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/labelLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Idioma del juego"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/descLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="La traduccion completa sigue en desarrollo."
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/accent_gold"
                    android:popupBackground="@color/bg_card"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <TextView
                android:id="@+id/titleAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif"
                android:text="CUENTA Y PERFIL"
                android:textColor="@color/accent_gold"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/accountCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_btn_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/accountStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="ONLINE EXPERIMENTAL"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/accountDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Firebase activo para pruebas. Publica las reglas, usa codigo de sala y revisa Logcat con TraidoresOnline. Las cuentas y estadisticas siguen pendientes."
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnFirebaseSmokeTest"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_profile_selection_selected"
                    android:fontFamily="sans-serif"
                    android:text="PROBAR FIREBASE"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/firebaseSmokeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="Comprueba pruebas/conexion_inicial. Para salas usa Jugar > Online."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnResetOptions"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_btn_dark"
                android:fontFamily="sans-serif"
                android:text="RESTABLECER OPCIONES"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_menu" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_btn_dark"
        android:contentDescription="Volver"
        android:src="@android:drawable/ic_media_previous"
        app:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/titlePlayMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/bree_serif"
        android:letterSpacing="0"
        android:text="SELECCIONAR MODO"
        android:textColor="@color/accent_gold"
        android:textSize="23sp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/titlePlayMode"
        android:layout_marginTop="12dp"
        android:layout_alignParentBottom="true"
        android:paddingBottom="24dp">

        <FrameLayout
            android:id="@+id/cardLocal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_mode_card"
            android:clickable="true"
            android:clipToOutline="true"
            android:focusable="true"
            android:padding="2dp"
            app:layout_constraintDimensionRatio="3:2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/cardOnline"
            app:layout_constraintVertical_chainStyle="packed">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgLocalMode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/modo_juego_local_pampa_v3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_mode_title_scrim" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/bree_serif"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:shadowColor="#A0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    android:text="@string/btn_local"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cardOnline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_mode_card"
            android:clickable="true"
            android:clipToOutline="true"
            android:focusable="true"
            android:padding="2dp"
            app:layout_constraintDimensionRatio="3:2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardLocal"
            app:layout_constraintBottom_toBottomOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgOnlineMode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/modo_jugar_online" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_mode_title_scrim" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/bree_serif"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:shadowColor="#A0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    android:text="@string/btn_online"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />
            </FrameLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>


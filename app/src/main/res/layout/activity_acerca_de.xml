<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_menu" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#70000000" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="14dp"
        android:background="@drawable/bg_btn_dark"
        android:contentDescription="@string/btn_back"
        android:padding="10dp"
        android:src="@android:drawable/ic_media_previous"
        app:tint="@color/text_secondary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnBack"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="24dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bree_serif"
                android:letterSpacing="0.03"
                android:text="@string/about_title"
                android:textColor="@color/accent_gold"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/bandido_games"
                android:scaleType="fitCenter"
                android:src="@drawable/bandido_games_intro_idle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/bree_serif"
                android:text="@string/app_title"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/about_game_description"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_btn_dark"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.08"
                    android:text="@string/about_created_by"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/bree_serif"
                    android:text="@string/bandido_games"
                    android:textColor="@color/accent_gold"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="@string/about_studio_description"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/aboutVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnContactSupport"
                style="@style/BtnDark"
                android:layout_marginTop="18dp"
                android:text="@string/about_contact_support" />

            <Button
                android:id="@+id/btnPrivacyPolicy"
                style="@style/BtnDark"
                android:layout_marginTop="8dp"
                android:text="@string/privacy_policy_action" />

            <Button
                android:id="@+id/btnAccountDeletionInfo"
                style="@style/BtnDark"
                android:layout_marginTop="8dp"
                android:text="@string/account_deletion_info_action" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/bandido_games_support_email"
                android:textColor="@color/text_muted"
                android:textIsSelectable="true"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>

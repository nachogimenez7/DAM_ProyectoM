<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/bree_serif"
        android:gravity="center"
        android:text="@string/profile_account_dialog_title"
        android:textColor="@color/accent_gold"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/accountDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/profile_account_dialog_message"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/accountGoogleButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_gold_ripple"
        android:fontFamily="@font/bree_serif"
        android:text="CONTINUAR CON GOOGLE"
        android:textColor="@color/bg_dark"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/accountEmailDivider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="O USÁ TU CORREO"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/accountEmailInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:autofillHints="emailAddress"
        android:background="@drawable/bg_chat_input"
        android:hint="@string/profile_account_email_hint"
        android:importantForAutofill="yes"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/accountPasswordInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:autofillHints="password"
        android:background="@drawable/bg_chat_input"
        android:hint="@string/profile_account_password_hint"
        android:importantForAutofill="yes"
        android:inputType="textPassword"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/accountDialogError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:textColor="@color/traitor_red_bright"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_menu" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#52000000" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_btn_dark"
        android:contentDescription="Volver"
        android:padding="10dp"
        android:src="@android:drawable/ic_media_previous"
        app:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/profileTitle"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_alignTop="@id/btnBack"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/bree_serif"
        android:gravity="center"
        android:text="PERFIL"
        android:textColor="@color/accent_gold"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnBack"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="174dp">

                <View
                    android:id="@+id/profileBanner"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:background="@drawable/profile_banner_pampa"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageButton
                    android:id="@+id/editBanner"
                    style="@style/ProfileEditIcon"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp" />

                <FrameLayout
                    android:id="@+id/profileAvatarFrame"
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_profile_avatar_frame"
                    android:elevation="6dp"
                    android:padding="5dp">

                    <com.traidores.juego.CircleProfileImageView
                        android:id="@+id/profileAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_profile_avatar_clip"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:contentDescription="Ampliar foto de perfil"
                        android:focusable="true"
                        android:outlineProvider="background"
                        android:scaleType="matrix"
                        android:src="@drawable/rol_aldeano_gaucho" />

                    <ImageButton
                        android:id="@+id/editAvatar"
                        style="@style/ProfileEditIcon"
                        android:layout_gravity="bottom|end" />
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="38dp"
                    android:text="Jugador"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="32sp"
                    app:autoSizeMinTextSize="22sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />

                <ImageButton
                    android:id="@+id/editName"
                    style="@style/ProfileEditIcon"
                    android:layout_gravity="center_vertical|end" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/profilePublicId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="38dp"
                    android:text="#SIN ID"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="21sp"
                    app:autoSizeMinTextSize="15sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />

                <ImageButton
                    android:id="@+id/editPublicId"
                    style="@style/ProfileEditIcon"
                    android:layout_gravity="center_vertical|end" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/profileBioBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_profile_stat">

                <TextView
                    android:id="@+id/profileBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:paddingStart="44dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="44dp"
                    android:paddingBottom="14dp"
                    android:text="&quot;No fui yo. Esta vez.&quot;"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="italic" />

                <ImageButton
                    android:id="@+id/editBio"
                    style="@style/ProfileEditIcon"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="8dp" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif"
                android:text="ESTADISTICAS"
                android:textColor="@color/accent_gold"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/profileAccountSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_profile_stat"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statMatchesValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="--"
                        android:textColor="@color/accent_gold"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statMatchesLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Partidas"
                        android:textColor="@color/accent_gold"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_profile_stat"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statWinsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="--"
                        android:textColor="@color/accent_green"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statWinsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Victorias"
                        android:textColor="@color/accent_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_profile_stat"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statWinRateValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="--%"
                        android:textColor="@color/accent_gold"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statWinRateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Porcentaje"
                        android:textColor="@color/accent_gold"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/profileStatsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Las estadísticas se mostrarán cuando este perfil tenga progreso registrado."
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/favoriteRoleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_profile_stat"
                android:clickable="true"
                android:contentDescription="Ver información del rol Detective"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/favoriteRoleImage"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Rol favorito"
                    android:scaleType="matrix"
                    android:src="@drawable/rol_detective_gaucho" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="ROL FAVORITO"
                        android:textColor="@color/accent_gold"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/favoriteRoleName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="Detective"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="24sp"
                        app:autoSizeMinTextSize="16sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/editFavoriteRole"
                    style="@style/ProfileEditIcon" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:text="EMOTES"
                    android:textColor="@color/accent_gold"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/editEmotes"
                    style="@style/ProfileEditIcon"
                    android:layout_gravity="center_vertical|end" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/emoteLoadoutContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_stat"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/emoteOne"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_emote_slot"
                    android:contentDescription="Emote 1"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/reaction_angry" />

                <ImageView
                    android:id="@+id/emoteTwo"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_emote_slot"
                    android:contentDescription="Emote 2"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/reaction_sad" />

                <ImageView
                    android:id="@+id/emoteThree"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_emote_slot"
                    android:contentDescription="Emote 3"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/reaction_happy" />

                <ImageView
                    android:id="@+id/emoteFour"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_emote_slot"
                    android:contentDescription="Emote 4"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/reaction_suspicious" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:text="LOGROS DESTACADOS"
                    android:textColor="@color/accent_gold"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/editAchievements"
                    style="@style/ProfileEditIcon"
                    android:layout_gravity="center_vertical|end" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/achievementsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/achievementOne"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_profile_badge"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Engano"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/achievementTwo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_profile_badge"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Sobrevivir"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/achievementThree"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_profile_badge"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Ojo experto"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif"
                android:text="ÚLTIMA PARTIDA"
                android:textColor="@color/accent_gold"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/lastMatchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_stat"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="86dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lastMatchMapRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="Todavía no jugaste ninguna partida."
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="16sp"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:id="@+id/lastMatchResultDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif"
                        android:maxLines="2"
                        android:text="Las partidas locales finalizadas aparecerán aquí."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/lastMatchRoleImage"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_role_card"
                    android:clipToOutline="true"
                    android:contentDescription="Rol de la última partida"
                    android:padding="2dp"
                    android:scaleType="matrix"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_profile_stat"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bree_serif"
                    android:gravity="center"
                    android:text="@string/profile_account_title"
                    android:textColor="@color/accent_gold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/profileAccountState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="@string/profile_account_guest"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnProfileAccount"
                    style="@style/BtnDark"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="0dp"
                    android:minHeight="48dp"
                    android:text="@string/profile_account_action" />

            </LinearLayout>

            <Button
                android:id="@+id/btnEditProfile"
                style="@style/BtnGold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="0dp"
                android:text="EDITAR PERFIL" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

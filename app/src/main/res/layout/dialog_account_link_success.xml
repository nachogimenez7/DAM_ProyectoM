<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="8dp">

    <FrameLayout
        android:layout_width="78dp"
        android:layout_height="78dp">

        <ImageView
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_traidores_clean" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@string/account_link_success_badge_description"
            android:src="@drawable/ic_account_link_success" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/bree_serif"
        android:gravity="center"
        android:text="@string/account_link_success_title"
        android:textColor="@color/accent_gold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/accountLinkSuccessMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="1dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

</LinearLayout>

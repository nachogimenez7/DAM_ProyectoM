<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/assigningRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/animationStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/assigningTable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:alpha="0"
            android:contentDescription="@null"
            android:elevation="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/assigning_vertical_table_trailer" />

        <View
            android:id="@+id/assigningCandleGlow"
            android:layout_width="210dp"
            android:layout_height="250dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-42dp"
            android:layout_marginTop="-22dp"
            android:alpha="0"
            android:background="@drawable/bg_assigning_candle_glow"
            android:elevation="2dp"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/assigningVignette"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/bg_assigning_vignette"
            android:elevation="2dp"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/finalCardAura"
            android:layout_width="190dp"
            android:layout_height="270dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/bg_assigning_card_aura"
            android:elevation="3dp"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/finalCardShadow"
            android:layout_width="112dp"
            android:layout_height="174dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/bg_assigning_hand_shadow"
            android:elevation="4dp"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/assigningHands"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:elevation="8dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/assigningCardGripHands"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:elevation="8dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/shuffleCardLeft"
            android:layout_width="82dp"
            android:layout_height="131dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:contentDescription="Carta oculta"
            android:elevation="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/card_back_traidores" />

        <ImageView
            android:id="@+id/shuffleCardRight"
            android:layout_width="82dp"
            android:layout_height="131dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:contentDescription="Carta oculta"
            android:elevation="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/card_back_traidores" />

        <ImageView
            android:id="@+id/finalRoleCard"
            android:layout_width="82dp"
            android:layout_height="131dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:contentDescription="Tu carta oculta"
            android:elevation="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/card_back_traidores" />

        <ImageView
            android:id="@+id/assigningDealingHands"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:elevation="9dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/assigningStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:alpha="0"
            android:background="@drawable/bg_assigning_status"
            android:elevation="10dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="¡Buena suerte con tu rol!"
            android:textColor="@color/accent_gold"
            android:textSize="21sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:alpha="0"
        android:background="@drawable/bg_btn_dark"
        android:contentDescription="Volver al lobby"
        android:elevation="12dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_previous"
        app:tint="@color/text_secondary" />

</FrameLayout>

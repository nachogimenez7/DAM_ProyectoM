<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_player_chip"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/playerAvatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_player_avatar"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="?"
        android:textColor="@color/bg_dark"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/playerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        app:autoSizeMaxTextSize="17sp"
        app:autoSizeMinTextSize="11sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform" />

    <TextView
        android:id="@+id/playerStatus"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnPlayerProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_btn_dark_ripple"
        android:contentDescription="Ver perfil"
        android:padding="14dp"
        android:src="@drawable/ic_person_profile"
        app:tint="@color/text_secondary" />

    <ImageButton
        android:id="@+id/btnKickPlayer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_btn_dark_ripple"
        android:contentDescription="Expulsar participante"
        android:padding="15dp"
        android:src="@drawable/ic_remove_player"
        app:tint="@color/accent_red" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/lobbyMapBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/mapa_pampa" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_btn_dark_ripple"
        android:contentDescription="Volver"
        android:padding="11dp"
        android:src="@android:drawable/ic_media_previous"
        app:tint="@color/text_secondary" />

    <LinearLayout
        android:id="@+id/lobbyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="62dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_game_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lobbyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/bree_serif"
                android:maxLines="1"
                android:text="LOBBY LOCAL"
                android:textColor="@color/accent_gold"
                android:textSize="21sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="21sp"
                app:autoSizeMinTextSize="15sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/playerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bree_serif"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnLobbySettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_btn_dark_ripple"
            android:contentDescription="Opciones"
            android:padding="11dp"
            android:src="@drawable/ic_settings_gear"
            app:tint="@color/accent_gold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/lobbyBodyScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/lobbyHeader"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="12dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/lobbyBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/lobbyConfigurationPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_game_panel"
                android:orientation="vertical"
                android:padding="12dp">

                <Button
                    android:id="@+id/btnStartGame"
                    style="@style/BtnGold"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_btn_gold_ripple"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/lobby_start_local"
                    app:autoSizeMaxTextSize="15sp"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />

                <LinearLayout
                    android:id="@+id/onlineStartProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/onlineStartProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:indeterminate="false"
                        android:max="5"
                        android:progress="1"
                        android:progressDrawable="@drawable/bg_online_start_progress" />

                    <TextView
                        android:id="@+id/onlineStartProgressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/lobby_start_progress_players"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lobbyModeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="Modo normal: elige mapa, tiempos y participantes antes de iniciar."
                    android:textColor="@color/accent_gold"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnReleaseDisconnected"
                    style="@style/BtnDark"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_btn_dark_ripple"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="LIBERAR DESCONECTADOS"
                    android:textSize="10sp"
                    android:visibility="gone"
                    app:autoSizeMaxTextSize="10sp"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/onlineInviteLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.08"
                    android:text="@string/lobby_section_invite"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/onlineCodePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/bg_btn_dark"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="7dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:text="@string/lobby_room_code_label"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/onlineRoomCodeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:letterSpacing="0.16"
                        android:maxLines="1"
                        android:text="A7K2Q"
                        android:textColor="@color/accent_gold"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCopyRoomCode"
                            style="@style/BtnDark"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_dark_ripple"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="COPIAR"
                            android:textSize="10sp"
                            app:autoSizeMaxTextSize="10sp"
                            app:autoSizeMinTextSize="8sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <Button
                            android:id="@+id/btnShareRoomCode"
                            style="@style/BtnGold"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_gold_ripple"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="COMPARTIR"
                            android:textSize="10sp"
                            app:autoSizeMaxTextSize="10sp"
                            app:autoSizeMinTextSize="7sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/onlinePlayersLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.08"
                    android:text="@string/lobby_section_players"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/onlinePlayersScroll"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_game_panel"
                    android:fillViewport="true"
                    android:padding="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/onlinePlayersContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/lobbyConfigurationLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.08"
                    android:text="@string/lobby_section_configuration"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/onlinePlayerTargetPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_btn_dark"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnDecreaseExpectedPlayers"
                            style="@style/BtnDark"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:text="−"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/onlineExpectedPlayersText"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="5 JUGADORES"
                            android:textColor="@color/accent_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnIncreaseExpectedPlayers"
                            style="@style/BtnDark"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:text="+"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnPlayWithPresent"
                        style="@style/BtnDark"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="5dp"
                        android:maxLines="1"
                        android:text="JUGAR CON LOS PRESENTES"
                        android:visibility="gone"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/selectedMapCard"
                    android:layout_width="match_parent"
                    android:layout_height="126dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_btn_dark"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="2dp">

                    <ImageView
                        android:id="@+id/selectedMapImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#7A000000" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:paddingHorizontal="13dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/selectedMapName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/bree_serif"
                            android:maxLines="1"
                            android:text="PAMPA"
                            android:textColor="@color/accent_gold"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/selectedMapRole"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:text="Rol exclusivo: Payador"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/onlineMapVoteHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="VOTACIÓN DE MAPA"
                        android:textColor="@color/accent_gold"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toca el que quieras"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mapVoteCardsRow"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:padding="2dp">

                        <ImageView
                            android:id="@+id/mapPampa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:contentDescription="Mapa Pampa"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:scaleType="centerCrop" />

                        <View
                            android:id="@+id/mapPampaShade"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#99000000"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/mapPampaVoteOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/mapPampaVoteTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="Pampa"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/mapPampaVoteCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/lobby_map_vote_empty"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/mapPampaVoteVoters"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textColor="@color/accent_gold"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/mapPampaDefaultBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_map_default_badge"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="2dp"
                            android:text="@string/lobby_map_default_badge"
                            android:textColor="@color/bg_dark"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:padding="2dp">

                        <ImageView
                            android:id="@+id/mapGrecia"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:contentDescription="Mapa Grecia"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:scaleType="centerCrop" />

                        <View
                            android:id="@+id/mapGreciaShade"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#99000000"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/mapGreciaVoteOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/mapGreciaVoteTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="Grecia"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/mapGreciaVoteCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/lobby_map_vote_empty"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/mapGreciaVoteVoters"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textColor="@color/accent_gold"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/mapGreciaDefaultBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_map_default_badge"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="2dp"
                            android:text="@string/lobby_map_default_badge"
                            android:textColor="@color/bg_dark"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:padding="2dp">

                        <ImageView
                            android:id="@+id/mapMedieval"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:contentDescription="Mapa Medieval"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:scaleType="centerCrop" />

                        <View
                            android:id="@+id/mapMedievalShade"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#99000000"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/mapMedievalVoteOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/mapMedievalVoteTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="Medieval"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/mapMedievalVoteCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/lobby_map_vote_empty"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/mapMedievalVoteVoters"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textColor="@color/accent_gold"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/mapMedievalDefaultBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_map_default_badge"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="2dp"
                            android:text="@string/lobby_map_default_badge"
                            android:textColor="@color/bg_dark"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/mapVoteResultHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@color/accent_gold"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mapDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="1dp"
                    android:text="Usa el perfil o la X de cada participante. Inicia con cinco o mas jugadores."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTimingOptions"
                        style="@style/BtnDark"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark_ripple"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="OPCIONES DE PARTIDA"
                        android:textSize="11sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <Button
                        android:id="@+id/btnAdvancedOptions"
                        style="@style/BtnDark"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark_ripple"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="OPCIONES AVANZADAS"
                        android:textSize="11sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>

                <TextView
                    android:id="@+id/practiceRoleSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_btn_dark_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="42dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"
                    android:text="@string/lobby_practice_summary_default"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif"
                    android:id="@+id/lobbyPlayersLabel"
                    android:letterSpacing="0.08"
                    android:text="JUGADORES"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAddPlayer"
                        style="@style/BtnDark"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark_ripple"
                        android:text="AGREGAR"
                        android:textSize="12sp"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <Button
                        android:id="@+id/btnRemovePlayer"
                        style="@style/BtnDark"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark_ripple"
                        android:text="QUITAR"
                        android:textSize="12sp"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/playersListPanel"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_game_panel"
                android:fillViewport="true"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/playersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/lobbyChatDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_game_panel"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/bree_serif"
                android:text="Qué se dice en la sala"
                android:textColor="@color/accent_gold"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lobbyChatActionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca para hablar"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/btnToggleLobbyChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_btn_dark_ripple"
                android:contentDescription="Ocultar vista previa del chat"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                app:tint="@color/accent_gold" />
        </LinearLayout>

        <TextView
            android:id="@+id/lobbyChatPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:text="Todavia no hay mensajes."
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>
</RelativeLayout>

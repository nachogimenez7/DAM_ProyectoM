<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/lobbyMapBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/mapa_pampa" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_btn_dark_ripple"
        android:contentDescription="Volver"
        android:padding="9dp"
        android:src="@android:drawable/ic_media_previous"
        app:tint="@color/text_secondary" />

    <LinearLayout
        android:id="@+id/lobbyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="62dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_game_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lobbyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/bree_serif"
                android:maxLines="1"
                android:text="LOBBY LOCAL"
                android:textColor="@color/accent_gold"
                android:textSize="21sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="21sp"
                app:autoSizeMinTextSize="15sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/playerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bree_serif"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnLobbySettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_btn_dark_ripple"
            android:contentDescription="Opciones"
            android:padding="11dp"
            android:src="@drawable/ic_settings_gear"
            app:tint="@color/accent_gold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/lobbyBodyScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/lobbyHeader"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="12dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/lobbyBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_game_panel"
                android:orientation="vertical"
                android:padding="12dp">

                <Button
                    android:id="@+id/btnStartGame"
                    style="@style/BtnGold"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_btn_gold_ripple"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="INICIAR"
                    app:autoSizeMaxTextSize="15sp"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/lobbyModeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="Modo normal: elige mapa, tiempos y participantes antes de iniciar."
                    android:textColor="@color/accent_gold"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnReleaseDisconnected"
                    style="@style/BtnDark"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_btn_dark_ripple"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="LIBERAR DESCONECTADOS"
                    android:textSize="10sp"
                    android:visibility="gone"
                    app:autoSizeMaxTextSize="10sp"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />

                <LinearLayout
                    android:id="@+id/onlineCodePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/bg_btn_dark"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="7dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:text="CODIGO DE SALA"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/onlineRoomCodeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:letterSpacing="0.16"
                        android:maxLines="1"
                        android:text="A7K2Q"
                        android:textColor="@color/accent_gold"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCopyRoomCode"
                            style="@style/BtnDark"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_dark_ripple"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="COPIAR"
                            android:textSize="10sp"
                            app:autoSizeMaxTextSize="10sp"
                            app:autoSizeMinTextSize="8sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <Button
                            android:id="@+id/btnShareRoomCode"
                            style="@style/BtnGold"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_gold_ripple"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="COMPARTIR"
                            android:textSize="10sp"
                            app:autoSizeMaxTextSize="10sp"
                            app:autoSizeMinTextSize="7sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/selectedMapCard"
                    android:layout_width="match_parent"
                    android:layout_height="126dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_btn_dark"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="2dp">

                    <ImageView
                        android:id="@+id/selectedMapImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#7A000000" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:paddingHorizontal="13dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/selectedMapName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/bree_serif"
                            android:maxLines="1"
                            android:text="PAMPA"
                            android:textColor="@color/accent_gold"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/selectedMapRole"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:text="Rol exclusivo: Payador"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/mapPampa"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:contentDescription="Mapa Pampa"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="2dp"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/mapGrecia"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:contentDescription="Mapa Grecia"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="2dp"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/mapMedieval"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:contentDescription="Mapa Medieval"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="2dp"
                        android:scaleType="centerCrop" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mapDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="1dp"
                    android:text="Usa el perfil o la X de cada participante. Inicia con cinco o mas jugadores."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/debugRoleSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="ROL HUMANO"
                        android:textColor="@color/accent_gold"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnDebugRole"
                        style="@style/BtnDark"
                        android:layout_height="38dp"
                        android:layout_marginBottom="0dp"
                        android:background="@drawable/bg_btn_dark_ripple"
                        android:text="ROL: AZAR"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.08"
                    android:text="CONFIGURACION"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTimingOptions"
                        style="@style/BtnDark"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark_ripple"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="TIEMPOS"
                        android:textSize="11sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <Button
                        android:id="@+id/btnAdvancedOptions"
                        style="@style/BtnDark"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark_ripple"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="OPCIONES AVANZADAS"
                        android:textSize="11sp"
                        app:autoSizeMaxTextSize="11sp"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.08"
                    android:text="JUGADORES"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAddPlayer"
                        style="@style/BtnDark"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark_ripple"
                        android:text="AGREGAR"
                        android:textSize="12sp"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <Button
                        android:id="@+id/btnRemovePlayer"
                        style="@style/BtnDark"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark_ripple"
                        android:text="QUITAR"
                        android:textSize="12sp"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_game_panel"
                android:fillViewport="true"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/playersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

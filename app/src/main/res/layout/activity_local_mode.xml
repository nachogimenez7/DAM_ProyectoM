<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_menu" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_btn_dark"
        android:contentDescription="Volver"
        android:src="@android:drawable/ic_media_previous"
        app:tint="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/bree_serif"
            android:text="JUGAR vs IA"
            android:textColor="@color/accent_gold"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_btn_dark"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:text="Elige una dificultad. Después irás al lobby para ajustar mapa, tiempos y cantidad de jugadores."
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnNormalAi"
            style="@style/BtnGold"
            android:text="NORMAL" />

        <Button
            android:id="@+id/btnHardAi"
            style="@style/BtnDark"
            android:text="DIFICIL" />
    </LinearLayout>
</RelativeLayout>


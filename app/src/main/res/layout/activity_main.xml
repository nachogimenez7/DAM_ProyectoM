<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_menu" />

    <!-- Gradient overlay for depth -->

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnAbout"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/about_open"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="@string/bandido_games"
            android:textColor="@color/accent_gold"
            android:textSize="11sp"
            android:fontFamily="@font/bree_serif"
            android:letterSpacing="0.04" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_dark"
            android:contentDescription="Abrir perfil"
            android:padding="10dp"
            android:src="@drawable/ic_person_profile"
            app:tint="@color/accent_gold" />

    </LinearLayout>

    <!-- CENTER CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="40dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_traidores_clean" />

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:gravity="center"
            android:maxLines="1"
            android:text="TRAIDORES"
            android:textColor="@color/accent_gold"
            android:textSize="44sp"
            android:textStyle="bold"
            android:fontFamily="@font/bree_serif"
            android:letterSpacing="0"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="4"
            android:shadowRadius="8"
            android:layout_marginBottom="8dp" />

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desconfía de todos."
            android:textColor="@color/text_secondary"
            android:textSize="17sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0"
            android:layout_marginBottom="48dp" />

        <!-- JUGAR -->
        <Button
            android:id="@+id/btnPlay"
            style="@style/BtnGold"
            android:text="@string/btn_play" />

        <!-- ROLES -->
        <Button
            android:id="@+id/btnRoles"
            style="@style/BtnDark"
            android:text="@string/btn_roles" />

        <!-- AYUDA -->
        <Button
            android:id="@+id/btnHelp"
            style="@style/BtnDark"
            android:text="@string/btn_help" />

        <!-- OPCIONES -->
        <Button
            android:id="@+id/btnOptions"
            style="@style/BtnDark"
            android:text="@string/btn_options" />

    </LinearLayout>

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnMusic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_dark"
            android:contentDescription="Silenciar música"
            android:padding="10dp"
            android:src="@drawable/ic_music_note"
            app:tint="@color/text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/brandIntroOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#090909"
        android:clickable="true"
        android:elevation="32dp"
        android:focusable="false"
        android:visibility="gone">

        <ImageView
            android:id="@+id/bandidoIntroIdle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/bandido_games"
            android:scaleType="fitCenter"
            android:src="@drawable/bandido_games_intro_idle_portrait" />

        <ImageView
            android:id="@+id/bandidoIntroBark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/bandido_games_intro_bark_animation" />

        <View
            android:id="@+id/bandidoIntroGoldPulse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/bg_bandido_intro_glow"
            android:importantForAccessibility="no" />

    </FrameLayout>

</RelativeLayout>




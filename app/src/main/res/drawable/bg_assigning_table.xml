<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="90"
                android:startColor="#2A170A"
                android:centerColor="#4D2E16"
                android:endColor="#241308" />
            <stroke
                android:width="2dp"
                android:color="#6F4A25" />
        </shape>
    </item>
    <item android:left="10dp" android:top="14dp" android:right="10dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="90"
                android:startColor="#00000000"
                android:centerColor="#1FFFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>

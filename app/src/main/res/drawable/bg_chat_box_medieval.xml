<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#E018120D" />
            <stroke
                android:width="1dp"
                android:color="#B98A5B2A" />
        </shape>
    </item>
    <item android:inset="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="90"
                android:startColor="#70311F11"
                android:centerColor="#551A120B"
                android:endColor="#8A0C0806" />
        </shape>
    </item>
    <item
        android:width="18dp"
        android:height="18dp"
        android:gravity="top|end"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <solid android:color="#8F6C1715" />
            <stroke
                android:width="1dp"
                android:color="#7A2C100F" />
        </shape>
    </item>
</layer-list>

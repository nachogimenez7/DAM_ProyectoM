<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#A77A20"
                android:startColor="#F4C85B" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#C08A27"
                android:startColor="#F3C75C" />
            <stroke
                android:width="1dp"
                android:color="#FFE3A0" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>

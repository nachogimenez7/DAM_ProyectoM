<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TraidoresApplication"
        android:allowBackup="true"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Traidores">

        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_traidores" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_beta_id" />

        <service
            android:name=".TraidoresMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Traidores.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".JugarActivity" android:screenOrientation="portrait" />
        <activity android:name=".LocalModeActivity" android:screenOrientation="portrait" />
        <activity android:name=".OnlineModeActivity" android:screenOrientation="portrait" />
        <activity android:name=".LobbyBrowserActivity" android:screenOrientation="portrait" />
        <activity
            android:name=".LobbyActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AssigningRolesActivity" android:screenOrientation="portrait" />
        <activity
            android:name=".GameplayMockActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".RolesActivity" android:screenOrientation="portrait" />
        <activity android:name=".AyudaActivity" android:screenOrientation="portrait" />
        <activity android:name=".OpcionesActivity" android:screenOrientation="portrait" />
        <activity android:name=".AcercaDeActivity" android:screenOrientation="portrait" />
        <activity android:name=".ProfileActivity" android:screenOrientation="portrait" />
        <activity android:name=".ProfileSelectionActivity" android:screenOrientation="portrait" />

    </application>
</manifest>
